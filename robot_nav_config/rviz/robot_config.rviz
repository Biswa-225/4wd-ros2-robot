# RViz config for the laptop-side Nav2 view.
#
# Normal data flow:
#   Pi publishes robot/Nav2 data over ROS 2 DDS.
#   Laptop RViz subscribes to these topics and sends goals/actions back.
#
# If another robot/system uses different names, change BOTH `Topic:` and
# `Value:` under the display:
#   map display             -> /map
#   laser display           -> /scan
#   robot model             -> /robot_description
#   AMCL pose               -> /amcl_pose
#   AMCL particles          -> /particle_cloud
#   global plan             -> /plan
#   local plan              -> /local_plan
#   waypoint marker arrows  -> /waypoints
#   local/global costmaps   -> /local_costmap/costmap, /global_costmap/costmap
#
# If TF frames are different:
#   Fixed Frame is currently `map`.
#   Use `odom` only for raw robot/scan checking without localization.
#   Use `map` for Nav2/AMCL navigation, waypoint following, and goals.

Panels:
  # Left-side RViz panels shown on startup.
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2

Visualization Manager:
  Class: ""
  Displays:
    # Background grid. Purely visual; it does not come from ROS topics.
    - Alpha: 0.5
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid

    # 3D robot model from /robot_description.
    # Change this only if your robot_state_publisher publishes the URDF on a
    # different topic.
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /robot_description
        Value: /robot_description

    # TF tree display. This is how RViz knows map -> odom -> base_link and
    # base_link -> laser/camera/wheel frames.
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Frame Timeout: 15

    # Static occupancy map from Nav2 map_server.
    # If map_server uses another topic, change /map in both places below.
    - Alpha: 1.0
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /map
        Value: /map

    # Global costmap from Nav2. Shows inflated obstacles used by global planner.
    # Alternate common topic: /global_costmap/costmap_raw.
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
      Name: Global Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /global_costmap/costmap
        Value: /global_costmap/costmap

    # Local costmap around the robot. Disabled by default to keep the view clean.
    # Enable when debugging local obstacle avoidance.
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: false
      Enabled: false
      Name: Local Costmap
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /local_costmap/costmap
        Value: /local_costmap/costmap

    # Live LD19 laser scan. Topic must match the LaserScan publisher.
    # Your robot currently publishes /scan with frame_id base_laser.
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 0; 0
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Topic: /scan
        Value: /scan

    # AMCL estimated robot pose with covariance.
    # If using SLAM instead of AMCL, this topic may not exist.
    - Alpha: 1.0
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 255; 85; 255
      Enabled: true
      Name: AMCL Pose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /amcl_pose
        Value: /amcl_pose

    # AMCL particle cloud. Helpful for seeing localization confidence/spread.
    - Alpha: 1.0
      Class: nav2_rviz_plugins/ParticleCloud
      Color: 0; 180; 0
      Enabled: true
      Max Arrow Length: 0.3
      Min Arrow Length: 0.02
      Name: AMCL Particle Swarm
      Shape: Arrow (Flat)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Topic: /particle_cloud
        Value: /particle_cloud

    # Nav2 global path from planner_server.
    # This is the long route on the map.
    - Alpha: 1.0
      Class: rviz_default_plugins/Path
      Color: 0; 170; 0
      Enabled: true
      Name: Global Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /plan
        Value: /plan

    # Nav2 local path from controller_server.
    # This is the short trajectory the controller is currently following.
    - Alpha: 1.0
      Class: rviz_default_plugins/Path
      Color: 0; 100; 255
      Enabled: true
      Name: Local Plan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /local_plan
        Value: /local_plan

    # Waypoint arrows/labels shown by the Nav2 RViz panel.
    # This display is important: without /waypoints MarkerArray you can add
    # waypoints but may not see them clearly in RViz.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Waypoints
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /waypoints
        Value: /waypoints
      Value: true

    # Optional controller/debug markers. Disabled because /waypoints is the
    # useful marker stream for waypoint mode.
    - Class: rviz_default_plugins/MarkerArray
      Enabled: false
      Name: Controller Trajectories
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /marker
        Value: /marker
      Value: false

    # Robot footprint from local costmap. Enable if checking collision shape.
    - Alpha: 1.0
      Class: rviz_default_plugins/Polygon
      Color: 25; 255; 0
      Enabled: false
      Name: Local Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /local_costmap/published_footprint
        Value: /local_costmap/published_footprint
      Value: false

    # Robot footprint from global costmap. Usually less useful than local.
    - Alpha: 1.0
      Class: rviz_default_plugins/Polygon
      Color: 255; 180; 0
      Enabled: false
      Name: Global Footprint
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /global_costmap/published_footprint
        Value: /global_costmap/published_footprint
      Value: false
  Global Options:
    Background Color: 48; 48; 48
    # Main RViz coordinate frame.
    # Use `map` for Nav2/AMCL. Use `odom` only for raw robot bringup tests.
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    # Interact/move/select are normal RViz camera and selection tools.
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    # Nav2 Goal sends a normal navigation goal to Nav2.
    # The Nav2 panel also exposes waypoint/nav-through-poses modes.
    - Class: nav2_rviz_plugins/GoalTool
    # 2D Pose Estimate publishes /initialpose for AMCL localization.
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.02
      Covariance y: 0.02
      Covariance yaw: 0.02
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Topic: /initialpose
        Value: /initialpose
  Value: true
  Views:
    # Top-down view is best for maps, plans, goals, and waypoints.
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 120
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
